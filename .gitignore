# Dependencies
node_modules/

# Environment variables & secrets (CRITICAL: Never commit API keys)
.env
.env.local
.env.*.local

# Media Uploads & Outputs (Large video/audio files)
uploads/*
!uploads/.gitkeep
outputs/*
!outputs/.gitkeep

# Temporary & Scratch scripts
scratch/
scratch_*.js
*.tmp
*.log
app_log.txt
test_*.mp3

# OS & IDE files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Python Virtualenv & Caches
.venv/
__pycache__/
*.pyc

# Large Binaries & Desktop Builds
bin/*.exe
*.exe
dist/
build/
*.spec

# Android & Gradle Caches
.gradle/
android/.gradle/
android/build/
android/app/build/
build_output/

# Flutter & Dart Caches
.dart_tool/
flutter_app/.dart_tool/
flutter_app/build/
flutter_app/.flutter-plugins
flutter_app/.flutter-plugins-dependencies


